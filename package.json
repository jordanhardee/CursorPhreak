{
  "name": "cursorphreak",
  "productName": "CursorPhreak",
  "version": "1.0.1",
  "description": "A modern recreation of the CursorMania cursor picker for Windows and Linux.",
  "main": "src/main.js",
  "author": {
    "name": "jordanhardee",
    "url": "https://github.com/jordanhardee"
  },
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "catalog": "python3 -I tools/build_catalog.py \"$ARCHIVE\" assets/",
    "test": "node tools/test_encoders.js",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never && node tools/sign_mac.js",
    "test:mac": "node tools/test_macos.js",
    "dist:bsd": "python3 tools/package_bsd.py"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.cursorphreak.CursorPhreak",
    "productName": "CursorPhreak",
    "copyright": "CursorPhreak. Cursors from the CursorMania archive; all rights to their respective owners.",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/koffi/build/koffi/{freebsd_*,openbsd_*,musl_*,linux_arm64,linux_armhf,linux_ia32,linux_loong64,linux_riscv64d,win32_arm64,win32_ia32}/**",
      "!node_modules/koffi/{src,vendor,doc}/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "catalog.json",
          "*.pak"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "src/mac-agent.js",
      "src/catalog.js",
      "src/encoders.js",
      "src/platform/macos-*.js"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Classic CursorMania cursors for your desktop",
      "executableName": "cursorphreak",
      "syncDesktopName": true,
      "files": [
        "!node_modules/koffi/build/koffi/{darwin_*,win32_*}/**"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "files": [
        "!node_modules/koffi/build/koffi/{darwin_*,linux_*}/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "CursorPhreak",
      "artifactName": "CursorPhreak-Setup-${version}.${ext}"
    },
    "artifactName": "CursorPhreak-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0",
      "files": [
        "!node_modules/koffi/build/koffi/{linux_*,win32_*}/**"
      ],
      "extendInfo": {
        "NSHumanReadableCopyright": "Cursors from the CursorMania archive; all rights to their respective owners."
      }
    }
  },
  "desktopName": "cursorphreak.desktop",
  "homepage": "https://github.com/jordanhardee/CursorPhreak",
  "repository": {
    "type": "git",
    "url": "https://github.com/jordanhardee/CursorPhreak.git"
  }
}
